# Neo vibrator HAL: stream waveforms into the AW86927 driver through sysfs
allow hal_vibrator_default sysfs:dir search;
allow hal_vibrator_default vendor_sysfs_haptic:dir r_dir_perms;
allow hal_vibrator_default vendor_sysfs_haptic:file rw_file_perms;

# Master strength (persist.sys.neo.haptic.strength), set by NeoParts
get_prop(hal_vibrator_default, system_neo_prop)

# init makes custom_wave writable for the HAL (chown/chmod in the service's rc)
allow init vendor_sysfs_haptic:file { getattr setattr };
