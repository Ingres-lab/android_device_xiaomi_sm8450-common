     Dolby DMS HAL (hardware/dolby). Declared in manifest_xiaomi.xml; device-specific HALs
     must also appear in a framework compatibility matrix or check_vintf rejects the build.
-->
<compatibility-matrix version="1.0" type="framework">
    <hal format="hidl" optional="true">
        <name>vendor.dolby.hardware.dms</name>
        <version>2.0</version>
        <interface>
            <name>IDms</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
