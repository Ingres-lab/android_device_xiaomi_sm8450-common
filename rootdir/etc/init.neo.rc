# Bypass charging (NeoParts). night_charging makes the charger firmware run
# the phone from the adapter and stop charging once the battery is >= 80%.
on property:persist.sys.neo.bypass=1
    write /sys/class/qcom-battery/night_charging 1

on property:persist.sys.neo.bypass=0
    write /sys/class/qcom-battery/night_charging 0

on property:sys.boot_completed=1 && property:persist.sys.neo.bypass=1
    write /sys/class/qcom-battery/night_charging 1

# Vulkan driver (NeoParts): persist.sys.neo.gpu = adreno (default) | turnip.
# init.rc runs load_persist_props in its own post-fs-data action, which runs
# before this one, so the property is already loaded here; and post-fs-data
# runs before zygote-start, so the driver is in place before zygote preloads
# Vulkan and before SurfaceFlinger (class core, on boot) starts. The value is
# only read here, so a change applies on the next reboot. "adreno" binds the
# stock file onto itself, which is a no-op.
on post-fs-data
    mount none /vendor/lib64/hw/vulkan.${persist.sys.neo.gpu:-adreno}.so /vendor/lib64/hw/vulkan.adreno.so bind

# SELinux mode (NeoParts). The policy forbids setenforce from every enforcing
# domain, so a small helper in its own userdebug-only permissive domain does it.
service vendor.neo-selinux /vendor/bin/init.neo.selinux.sh
    class late_start
    user root
    group root
    oneshot
    disabled

on property:persist.sys.neo.selinux=*
    start vendor.neo-selinux

on property:sys.boot_completed=1 && property:persist.sys.neo.selinux=permissive
    start vendor.neo-selinux

# Color accuracy / flat mode (NeoParts): Xiaomi display feature 6 through
# mi_disp's disp_param. The kernel keeps the request across panel power-off and
# re-sends it on the first frame after power-on, so it is only written when the
# setting changes and once when persistent properties are loaded at boot.
on property:persist.sys.neo.flat=1
    write /sys/devices/virtual/mi_display/disp_feature/disp-DSI-0/disp_param "6 1"

on property:persist.sys.neo.flat=0
    write /sys/devices/virtual/mi_display/disp_feature/disp-DSI-0/disp_param "6 0"

# Foreground apps are latency sensitive (as on Pixel): EAS/WALT task placement then
# prefers idle CPUs for top-app tasks instead of packing them. It does not raise clocks.
on property:sys.boot_completed=1
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1

# Game performance mode (NeoParts > Gaming): while a chosen game is the focused app,
# top-app gets a utilization floor (uclamp.min, honoured by WALT). Threads that mostly wait
# on each other look idle to WALT, which then parks the cluster at its minimum clock and
# makes every cross-core hand-off ~2.7x slower; 50% keeps ntsync round trips near full
# speed (14.5 us vs 34.5 us measured). Re-applied when the level changes while active.
on property:sys.neo.game.boost=1
    write /dev/cpuctl/top-app/cpu.uclamp.min ${persist.sys.neo.game.floor:-50}

on property:sys.neo.game.boost=1 && property:persist.sys.neo.game.floor=*
    write /dev/cpuctl/top-app/cpu.uclamp.min ${persist.sys.neo.game.floor:-50}

on property:sys.neo.game.boost=0
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
